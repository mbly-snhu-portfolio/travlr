<div class="box">
	<div>
		<div class="body">
			<h1>Travel</h1>
			<ul id="sites">
				{{#each trips}}
				<li>
					<a href="/travel/{{code}}"><img src="/images/{{image}}" alt="Img"></a>
					<h2><a href="/travel/{{code}}">{{name}}</a></h2>
					<p>
						{{description}}
					</p>
					<span class="rate">Rate: ${{perPerson}} / Person</span>
					<p>
						<strong>Length:</strong> {{length}}<br>
						<strong>Start:</strong> {{start}}<br>
						<strong>Resort:</strong> {{resort}}
					</p>
				</li>
				{{/each}}
			</ul>
		</div>
	</div>
</div>

